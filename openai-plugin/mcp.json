{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "pixelflow": {
      "type": "streamable-http",
      "url": "https://api.pixelflow.so/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": ["mcp"]
          }
        }
      }
    }
  }
}
